# ==========================================
# Streamlit Secrets 설정 템플릿 (.streamlit/secrets.toml)
# ==========================================
# 주의: 이 파일의 이름을 secrets.toml로 복사한 뒤 실제 API 키를 입력하세요.
# secrets.toml 파일은 절대 GitHub 등 공개 저장소에 커밋(업로드)하면 안 됩니다!

GEMINI_API_KEY = "AIzaSyYourGeminiApiKeyHere"
ANTHROPIC_API_KEY = "sk-ant-YourAnthropicApiKeyHere"
OPENAI_API_KEY = "sk-proj-YourOpenAIApiKeyHere"

# (선택) GitHub Gist 자동 백업용 토큰
# GITHUB_GIST_TOKEN = "ghp_YourGitHubPersonalAccessToken"
